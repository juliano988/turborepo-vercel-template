{
  "name": "admin",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "postbuild": "bun run test && bun run test:integration:preview",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "bun run --filter @repo/db build && vitest run --config vitest.integration.config.ts",
    "test:integration:preview": "if [ \"$VERCEL\" = \"1\" ] && [ \"$VERCEL_ENV\" = \"preview\" ]; then if [ -z \"$DATABASE_URL\" ]; then echo 'DATABASE_URL is required for integration tests.'; exit 1; fi; bun run test:integration; else echo 'Skipping integration tests (requires Vercel preview).'; fi",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "prebuild": "bun ../../packages/scripts/vercel-env.ts"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.0.2",
    "@ant-design/pro-components": "^3.1.14-2",
    "@repo/auth": "*",
    "@repo/env": "*",
    "@repo/db": "*",
    "@repo/events": "*",
    "@repo/mq": "*",
    "@repo/eslint-config": "*",
    "@repo/proxy": "*",
    "@repo/typescript-config": "*",
    "@repo/ui": "*",
    "antd": "^6.5.0",
    "next": "16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/prettier-config": "*",
    "@repo/testing": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "@repo/ui": "*"
  },
  "peerDependencies": {
    "@repo/eslint-config": "*",
    "@repo/ui": "*",
    "@repo/typescript-config": "*"
  },
  "optionalDependencies": {
    "@repo/eslint-config": "*",
    "@repo/ui": "*",
    "@repo/typescript-config": "*"
  }
}
