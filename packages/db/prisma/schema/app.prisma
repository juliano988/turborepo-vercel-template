model AppUser {
  id     String    @id
  files  AppFile[]
  apiKey String?   @default("") @db.VarChar(255)

  @@map("user")
  @@schema("app")
}

model AppFile {
  id         String   @id
  name       String
  sizeBytes  Int
  mimeType   String
  ownerId    String
  blobUrl    String
  uploadedAt DateTime
  owner      AppUser  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("file")
  @@schema("app")
}
